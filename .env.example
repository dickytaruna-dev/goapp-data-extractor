# =========================================================
# GOAPP CREDENTIALS (Default / Shared)
# =========================================================
GOAPP_EMAIL=cs2@ikonsfurniture.com
GOAPP_PASSWORD=your_goapp_password_here

# =========================================================
# BRAND SPECIFIC GOAPP SETTINGS
# =========================================================
# IKONS
IKONS_BUSINESS_ID=136404588220488
IKONS_REPORT_ID=199
# Optional brand-specific credentials (falls back to GOAPP_EMAIL / GOAPP_PASSWORD if not provided)
# IKONS_GOAPP_EMAIL=
# IKONS_GOAPP_PASSWORD=

# MODULO
MODULO_BUSINESS_ID=136046770557000
MODULO_REPORT_ID=211
# MODULO_GOAPP_EMAIL=
# MODULO_GOAPP_PASSWORD=

# ZBOM
ZBOM_BUSINESS_ID=136046770557000
ZBOM_REPORT_ID=211
# ZBOM_GOAPP_EMAIL=
# ZBOM_GOAPP_PASSWORD=

# =========================================================
# TARGET API CONFIGURATION
# =========================================================
API_ENDPOINT_URL=https://api.yourdomain.com/v1/goapp/ingest
API_TIMEOUT_SECONDS=60
API_MAX_RETRIES=3

# =========================================================
# JWT AUTHENTICATION CONFIGURATION
# =========================================================
# Secret key used to sign the JWT token (or private key for RS256)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600
JWT_ISSUER=goapp-data-extractor
JWT_AUDIENCE=api.yourdomain.com

# If your API expects a static Bearer token instead of dynamic signing, configure it here:
# STATIC_BEARER_TOKEN=

# =========================================================
# EXTRACTION SETTINGS
# =========================================================
# Optional default date override (YYYY-MM-DD). If omitted or empty, defaults to yesterday.
# TARGET_DATE=2026-08-31

# Active brands to extract (comma-separated: IKONS,MODULO,ZBOM)
ACTIVE_BRANDS=IKONS,MODULO,ZBOM

# Headless browser mode (true/false)
HEADLESS=true

# Keep raw downloaded files after dispatch (true/false)
KEEP_LOCAL_FILES=false
